cabal-version:      3.0
name:               personal-site
version:            0.1.0.0
synopsis:           Ernest Sarfo's personal site, built with Hakyll
license:            NONE
build-type:         Simple

executable site
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Site.Colors
                      Site.Html
                      Site.Markdown
                      Site.Types
                      Site.Pages.Home
                      Site.Pages.Writing
                      Site.Pages.Projects
                      Site.Pages.Papers
                      Site.Pages.Skills
                      Site.Pages.Now
                      Site.Pages.Lens
                      Site.Pages.Renders
                      Site.Pages.Other
                      Site.Pages.Books
                      Site.Pages.Shelf
                      Site.Pages.NotFound
                      Site.Pages.Common
    build-depends:    base >=4 && <5
                    , aeson
                    , blaze-html
                    , blaze-markup
                    , bytestring
                    , containers
                    , filepath
                    , hakyll
                    , pandoc
                    , pandoc-types
                    , skylighting
                    , text
                    , time
    default-language: Haskell2010
    default-extensions: OverloadedStrings
    ghc-options:      -Wall -threaded
